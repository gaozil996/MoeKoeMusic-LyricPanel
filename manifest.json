{
  "manifest_version": 3,
  "name": "歌词悬浮面板",
  "plugin_id": "lyric-floating-panel",
  "version": "1.1.3",
  "description": "全屏歌词页原样搬入完整播放栏；播放列表弹层正常显示，队列歌曲改为紧凑单行并把时长放在歌名后。",
  "moekoe": true,
  "minversion": "1.7.0",
  "author": {
    "name": "SHIYI"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "world": "ISOLATED",
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "file:///*"
      ],
      "world": "MAIN",
      "js": [
        "queue-main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
